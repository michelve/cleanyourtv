<?xml version="1.0" encoding="utf-8"?>
<!-- tvos_menus: the dock's frosted glass (dock_glass: a white sheen fading downwards and its rim) over a dark tint that
     lets the wallpaper through but keeps the rows readable over the tiles, with the rounder corners of a tvOS menu
     (22dp). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B3121014" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#24FFFFFF" android:endColor="#0DFFFFFF" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
